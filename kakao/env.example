# ============================================
# TODO LIST 알림 서비스 - 환경변수 템플릿
# ============================================
# 사용법:
#   1) 이 파일을 복사해서 이름을 ".env"로 바꾸세요.
#   2) 아래 값들을 실제 발급받은 값으로 채우세요.
#   3) ".env" 파일은 절대 git에 올리지 마세요. (.gitignore에 반드시 포함)
#   4) 이 ".env.example" 파일은 값이 비어있으므로 git에 올려도 안전합니다.
# ============================================

# ---------- 데이터베이스 ----------
# backend와 같은 DB 파일을 봐야 한다. 컴퓨터마다 이 저장소를 어디에 클론했는지 다르므로
# 절대경로(예: E:/xxx/backend/app.db) 대신 상대경로를 쓴다 — kakao 폴더 안에서
# 실행한다는 전제(README의 "cd kakao && python main.py")하에 이 값 그대로 쓰면 된다.
DATABASE_URL=sqlite:///../backend/app.db

# ---------- Discord Bot ----------
# 발급 위치: https://discord.com/developers/applications
#   → 해당 앱 선택 → 왼쪽 메뉴 "Bot" → Token "Copy" 버튼
DISCORD_BOT_TOKEN=

# ---------- Discord Application (User-Install App 방식용) ----------
# Developer Portal → 해당 앱 → "General Information"의 Application ID
DISCORD_APPLICATION_ID=

# ---------- Google Calendar OAuth ----------
# 발급 위치: https://console.cloud.google.com/auth → "클라이언트(Clients)"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ⚠️ 주의: 이 값은 프론트엔드(8080) 주소가 아니라, 백엔드(FastAPI)에서
# 구글 인증 코드를 받아 처리할 콜백 경로여야 합니다.
# 혜림님과 FastAPI 실제 포트 번호를 확인한 뒤 맞춰주세요.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---------- 알림 스케줄러 설정 ----------
# 몇 분마다 "마감 1시간 전" 대상을 확인할지 (분 단위)
NOTIFICATION_CHECK_INTERVAL_MINUTES=5

# ---------- 연동 정보 암호화 키 ----------
# 구글 refresh token 등을 DB에 저장할 때 평문 저장 금지 → 암호화에 쓸 키
# 아래 명령어로 새로 생성해서 넣으세요:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---------- Discord OAuth (회원가입/설정 화면에서 "Discord 연동" 버튼용) ----------
# 발급 위치: 해당 앱 → "OAuth2" 메뉴
#   - Client Secret: 화면의 "Client Secret" (Client ID와 다른 값! 영문+숫자 섞인 긴 문자열)
#   - Redirects에 아래 DISCORD_REDIRECT_URI를 등록해야 함
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback

# ---------- (참고) JWT 인증 관련 ----------
# python-jose가 requirements에 있어 로그인 토큰(JWT) 발급에 쓰일 것으로 보입니다.
# 혜림님(백엔드) 담당 영역일 가능성이 높으니, 필요 여부를 먼저 확인하세요.
# JWT_SECRET_KEY=
# JWT_ALGORITHM=HS256
