# 이 파일을 복사해 .env로 만들고 실제 값을 채워 넣는다. (.env는 절대 커밋 금지)

# 인증
SECRET_KEY=change-this-to-a-long-random-string   # JWT 서명용

# 알림 (채널 정해지면 해당 줄만 채움)
NOTIFY_TARGET=discord     # 또는 telegram
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# DB
DATABASE_URL=sqlite:///./app.db

# ---------- kakao 파트(Discord 봇 + Google Calendar 연동) OAuth ----------
# 프론트 주소 (OAuth 콜백 완료 후 이 주소의 /settings로 리다이렉트됨)
FRONTEND_BASE_URL=http://localhost:5173

# Discord: https://discord.com/developers/applications 에서 발급
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback
# DM 발송용 봇 토큰 (해당 앱 -> Bot -> Token). REST API로 직접 보내므로 봇 프로세스를
# 따로 띄울 필요 없음 (app/discord_dm.py 참고).
DISCORD_BOT_TOKEN=

# Google Calendar: https://console.cloud.google.com/auth 에서 발급
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# 구글 refresh token 등을 DB에 암호화해서 저장할 때 쓰는 키
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
